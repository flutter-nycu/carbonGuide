# Public browser-side Supabase values. Never add service-role or OneSignal
# secrets to this file or to Vercel's VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here

# RAG is opt-in. Use the project explicitly approved for this phase.
# RAG shares the admin session; do not use a separate project's JWT.
VITE_RAG_ENABLED=false
VITE_RAG_PROJECT_REF=YOUR_PROJECT_ID

# Optional local Python RAG experiment only. Never rename to VITE_GEMINI_API_KEY.
# Put the real value in ignored .env.local, not in this example or frontend code.
GEMINI_API_KEY=
